{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SiM Catalyst Intelligence Report schema v1.1 — v6.3対応。イベント型(event_type)を追加、必須項目を削減（outcomes/priced_inを条件付きに変更）、validation_summaryをblocking_warn_count/info_warn_count対応に変更、evidenceClassにHISTORICAL_RANGEを追加、pricedInにラベル体系を追加",
  "title": "SiM Catalyst Intelligence Report v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "summary",
    "catalysts",
    "dependency_groups",
    "watch_items",
    "assumptions",
    "sources",
    "validation_summary",
    "disclaimer"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_name",
        "ticker",
        "exchange",
        "currency",
        "valuation_date",
        "last_updated",
        "source_cutoff",
        "framework_version",
        "current_price_fallback",
        "current_price_as_of"
      ],
      "properties": {
        "company_name": {"type": "string", "minLength": 1},
        "ticker": {"type": "string", "minLength": 1},
        "exchange": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "valuation_date": {"type": "string", "format": "date"},
        "last_updated": {"type": "string"},
        "source_cutoff": {"type": "string"},
        "framework_version": {"const": "1.1"},
        "current_price_fallback": {"type": "number", "exclusiveMinimum": 0},
        "current_price_as_of": {"type": "string"},
        "benchmark": {"type": ["string", "null"]},
        "diluted_shares": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "market": {"enum": ["US", "JP", null]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "one_line",
        "next_catalyst_id",
        "next_window",
        "primary_risk"
      ],
      "properties": {
        "status": {
          "enum": [
            "CATALYST_RICH",
            "SELECTIVE",
            "EXPECTATIONS_HIGH",
            "BINARY",
            "NO_CONFIRMED_CATALYST"
          ]
        },
        "one_line": {"type": "string", "minLength": 1},
        "next_catalyst_id": {"type": ["string", "null"]},
        "next_window": {"type": "string"},
        "primary_risk": {"type": "string"},
        "surprise_up": {"type": "string"},
        "surprise_down": {"type": "string"},
        "overall_priced_in": {"$ref": "#/$defs/pricedIn"}
      }
    },
    "catalysts": {
      "type": "array",
      "items": {"$ref": "#/$defs/catalyst"}
    },
    "dependency_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "catalyst_ids", "relationship", "aggregation_rule"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "catalyst_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          },
          "relationship": {"type": "string"},
          "aggregation_rule": {"type": "string"}
        }
      }
    },
    "watch_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "why_it_matters", "frequency", "update_trigger", "catalyst_ids"],
        "properties": {
          "item": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "frequency": {"type": "string"},
          "update_trigger": {"type": "string"},
          "catalyst_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "extra_sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/extraSection"}
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "value", "classification", "as_of", "source_ids", "note"],
        "properties": {
          "item": {"type": "string"},
          "value": {},
          "classification": {"$ref": "#/$defs/evidenceClass"},
          "as_of": {"type": "string"},
          "source_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "note": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fail_count", "blocking_warn_count", "info_warn_count", "messages"],
      "properties": {
        "status": {
          "$comment": "PASS: FAIL/BLOCKING_WARN 0件。INFO_WARN: 公開可能だが注意事項あり。BLOCKING_WARN: 公開停止。FAIL: 公開禁止",
          "enum": ["PASS", "INFO_WARN", "BLOCKING_WARN", "FAIL"]
        },
        "fail_count": {"type": "integer", "minimum": 0},
        "blocking_warn_count": {"type": "integer", "minimum": 0},
        "info_warn_count": {"type": "integer", "minimum": 0},
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "check_id", "message"],
            "properties": {
              "level": {"enum": ["FAIL", "BLOCKING_WARN", "INFO_WARN", "PASS"]},
              "check_id": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    },
    "update_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["updated_at", "change"],
        "properties": {
          "updated_at": {"type": "string"},
          "change": {"type": "string"},
          "deleted_info": {
            "$comment": "情報を削除した場合はその理由を記録する",
            "type": "string"
          }
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evidenceClass": {
      "$comment": "v6.3: HISTORICAL_RANGEを追加（過去の同社または類似事例から算出）",
      "enum": [
        "CONFIRMED",
        "COMPANY_GUIDANCE",
        "CONSENSUS",
        "HISTORICAL_RANGE",
        "MODEL_ESTIMATE",
        "UNKNOWN"
      ]
    },
    "eventType": {
      "$comment": "イベントの定量化可能度を表す分類",
      "enum": [
        "QUANTITATIVE",
        "SEMI_QUANTITATIVE",
        "QUALITATIVE"
      ]
    },
    "pricedInLabel": {
      "$comment": "段階評価ラベル。1点の数値を強制しない",
      "enum": [
        "LOW",
        "LOW_TO_MEDIUM",
        "MEDIUM",
        "MEDIUM_TO_HIGH",
        "HIGH",
        "UNKNOWN",
        "ほぼ未織り込み",
        "一部織り込み",
        "半分前後",
        "かなり織り込み",
        "大半を織り込み",
        "定量不能"
      ]
    },
    "dateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_text",
        "start_date",
        "end_date",
        "precision",
        "basis",
        "confidence",
        "timezone",
        "source_ids"
      ],
      "properties": {
        "display_text": {"type": "string"},
        "start_date": {"type": ["string", "null"], "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"},
        "precision": {
          "enum": ["EXACT", "WEEK", "MONTH", "QUARTER", "HALF", "YEAR", "WINDOW", "TBD"]
        },
        "basis": {"$ref": "#/$defs/evidenceClass"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "timezone": {"type": ["string", "null"]},
        "source_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "numericRange": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "outcome": {
      "$comment": "結果パターン。label はイベント型に応じて柔軟に使用可能。SUCCESS/INLINE/FAILUREに限定しない",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "conditions"
      ],
      "properties": {
        "label": {
          "$comment": "定量型: SUCCESS/INLINE/FAILURE または OUTPERFORM/INLINE/UNDERPERFORM。定性型: POSITIVE/NEUTRAL/NEGATIVE。二値型: SUCCESS/FAILURE も可",
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "quantifiable": {"type": "boolean"},
        "quantification_basis": {
          "$comment": "定量評価に使用した手法（どの優先順位を適用したか）",
          "$ref": "#/$defs/evidenceClass"
        },
        "price_change_pct_range": {
          "oneOf": [
            {"$ref": "#/$defs/numericRange"},
            {"type": "null"}
          ]
        },
        "price_range": {
          "oneOf": [
            {"$ref": "#/$defs/numericRange"},
            {"type": "null"}
          ]
        },
        "direction": {"enum": ["UP", "FLAT", "DOWN", "MIXED", "UNKNOWN"]},
        "effect_on_assumptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "unquantifiable_reason": {
          "$comment": "quantifiable=falseの場合は必須。なぜ数値化できないか、何が分かれば数値化できるかを記録",
          "type": "string"
        },
        "qualitative_assessment": {
          "$comment": "定量不能・定性型の場合の代替評価",
          "type": "string"
        },
        "revaluation_trigger": {
          "$comment": "何が分かれば定量評価できるか",
          "type": "string"
        }
      }
    },
    "pricedIn": {
      "$comment": "v6.3: percent_rangeはオプション。label（段階評価）を優先。1点の数値を強制しない",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantifiable",
        "label",
        "confidence"
      ],
      "properties": {
        "quantifiable": {"type": "boolean"},
        "percent_range": {
          "$comment": "オプション。定量評価できる場合のみ記録",
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 0, "maximum": 100},
                {"type": "number", "minimum": 0, "maximum": 100}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {"type": "null"}
          ]
        },
        "raw_implied_pct": {
          "$comment": "オプション。企業価値ベースの生の計算結果（0-100%を超える場合も正直に記録）",
          "type": ["number", "null"]
        },
        "label": {
          "$comment": "段階評価ラベル。percent_rangeがない場合はこちらを使用する",
          "$ref": "#/$defs/pricedInLabel"
        },
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "model": {
          "$comment": "オプション。定量評価を行った場合のモデル説明",
          "type": "string"
        },
        "event_excluded_equity_value": {"type": ["number", "null"]},
        "full_success_incremental_equity_value": {"type": ["number", "null"]},
        "market_implied_success_probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "independent_success_probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "evidence_for": {
          "$comment": "織り込みが進んでいる根拠",
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_against": {
          "$comment": "織り込みが少ない根拠（反証）",
          "type": "array",
          "items": {"type": "string"}
        },
        "caveats": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unquantifiable_reason": {
          "$comment": "quantifiable=falseの場合に記録。なぜ数値化できないか、何が分かれば数値化できるかを説明",
          "type": "string"
        },
        "qualitative_assessment": {
          "$comment": "定量不能時の代替評価テキスト",
          "type": "string"
        },
        "revaluation_trigger": {
          "$comment": "何が開示されれば定量評価できるか",
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessed_at",
        "source_type",
        "is_primary",
        "supports_catalyst_ids"
      ],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "published_at": {"type": ["string", "null"]},
        "accessed_at": {"type": "string"},
        "source_type": {
          "enum": [
            "IR",
            "FILING",
            "REGULATOR",
            "GOVERNMENT",
            "EXCHANGE",
            "PARTNER",
            "MARKET_DATA",
            "INDUSTRY_DATA",
            "NEWS",
            "ANALYST",
            "OTHER"
          ]
        },
        "is_primary": {"type": "boolean"},
        "supports_catalyst_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "extraSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "items", "source_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          }
        },
        "source_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "catalyst": {
      "$comment": "v6.3: event_typeを追加。outcomesとpriced_inをオプション化。quantification_priorityを追加",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "event_type",
        "category",
        "status",
        "importance",
        "direction",
        "date",
        "plain_language",
        "why_it_matters",
        "update_triggers",
        "source_ids"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "event_type": {
          "$comment": "イベントの定量化可能度。必須",
          "$ref": "#/$defs/eventType"
        },
        "category": {
          "enum": [
            "EARNINGS",
            "PRODUCT",
            "CAPACITY",
            "R_AND_D",
            "REGULATORY",
            "CONTRACT",
            "PARTNERSHIP",
            "M_AND_A",
            "FINANCING",
            "POLICY",
            "LEGAL",
            "INDUSTRY",
            "EVENT",
            "OTHER"
          ]
        },
        "status": {
          "enum": [
            "SCHEDULED",
            "WINDOWED",
            "ONGOING",
            "CONTINGENT",
            "TBD",
            "UNCONFIRMED"
          ]
        },
        "importance": {"type": "integer", "minimum": 1, "maximum": 5},
        "direction": {"enum": ["POSITIVE", "NEGATIVE", "TWO_SIDED", "NEUTRAL"]},
        "date": {"$ref": "#/$defs/dateWindow"},
        "plain_language": {
          "$comment": "初心者向けの一文説明（必須）",
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "$comment": "なぜこのイベントが重要か（必須）",
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "$comment": "オプション：詳細説明",
          "type": "string"
        },
        "mechanism": {
          "$comment": "オプション：企業価値へ伝わる仕組み",
          "type": "array",
          "items": {"type": "string"}
        },
        "quantification_priority": {
          "$comment": "定量評価に適用した優先順位（1=一次情報、2=会社予想、3=コンセンサス、4=過去反応、5=同業比較、6=モデル推定、7=推定レンジ、8=定量不能）",
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 8
        },
        "outcomes": {
          "$comment": "条件付き：定量型は推奨、半定量型は可、定性型は不要。minItems制約を削除してイベント型に応じた柔軟な数を許可",
          "type": "array",
          "items": {"$ref": "#/$defs/outcome"}
        },
        "impact_method": {
          "$comment": "条件付き：定量評価した場合はどの方法を使ったか",
          "type": "string"
        },
        "impact_horizon": {
          "$comment": "条件付き：影響が現れる時間軸",
          "type": "string"
        },
        "impact_confidence": {
          "$comment": "条件付き：影響の確度",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "price_impact_direction": {
          "$comment": "定量レンジが出せない場合の代替：方向性のみ",
          "enum": ["UP", "DOWN", "FLAT", "MIXED", "UNKNOWN"]
        },
        "price_impact_magnitude": {
          "$comment": "定量レンジが出せない場合の代替：影響度段階",
          "enum": ["LARGE", "MEDIUM", "SMALL", "NEGLIGIBLE", "UNKNOWN"]
        },
        "price_impact_unquantifiable_reason": {
          "$comment": "定量不能の場合は必須：なぜ数値化できないか、何が分かれば数値化できるかを記録",
          "type": "string"
        },
        "price_impact_revaluation_trigger": {
          "$comment": "定量不能の場合：何が開示されれば定量評価できるか",
          "type": "string"
        },
        "priced_in": {
          "$comment": "条件付き：根拠がある場合のみ。定性型イベントでは省略可",
          "$ref": "#/$defs/pricedIn"
        },
        "leading_indicators": {
          "$comment": "条件付き：先行指標",
          "type": "array",
          "items": {"type": "string"}
        },
        "dependencies": {
          "$comment": "条件付き：依存する別イベントのID",
          "type": "array",
          "items": {"type": "string"}
        },
        "dependency_group": {
          "$comment": "条件付き：二重計上防止のためのグループID",
          "type": ["string", "null"]
        },
        "sell_the_news_risk": {
          "$comment": "条件付き：材料出尽くしのリスク",
          "type": "string"
        },
        "financing_risk": {
          "$comment": "条件付き：資金調達・希薄化リスク",
          "type": "string"
        },
        "success_probability": {
          "$comment": "条件付き：根拠と基準日がある場合のみ記録",
          "type": "object",
          "properties": {
            "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "basis": {"$ref": "#/$defs/evidenceClass"},
            "as_of": {"type": "string"},
            "note": {"type": "string"}
          }
        },
        "dilution_impact": {
          "$comment": "条件付き：希薄化影響（増資・転換社債等のある場合）",
          "type": "string"
        },
        "update_triggers": {
          "$comment": "必須：次回更新条件。最低1件",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "extra_items": {
          "$comment": "固定項目に入らない重要情報",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "source_ids"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "source_ids": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
