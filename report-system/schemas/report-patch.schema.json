{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SiM report safe patch schema v1.1 — baseRevision is the authoritative concurrency guard; gitCommitSha is optional.",
  "title": "SiM report safe patch",
  "type": "object",
  "required": ["schemaVersion", "reportId", "baseRevision", "reason", "changedFields", "changes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "minLength": 1 },
    "gitCommitSha": { "type": ["string", "null"] },
    "patchMode": { "enum": ["patch", "correction", "corporate-action"], "default": "patch" },
    "reason": { "type": "string", "minLength": 5 },
    "changedFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "changes": { "type": "object", "minProperties": 1 },
    "deletedInfo": { "type": "string" },
    "appliedAt": { "type": ["string", "null"] },
    "appliedRevision": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
