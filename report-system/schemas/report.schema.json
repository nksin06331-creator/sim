{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SiM unified stock report schema v1.1 — V6.3 three-page compatible operations. review and price-only removed; coverage waivers and validation warnings split by publishability.",
  "title": "SiM unified stock report",
  "type": "object",
  "required": ["schemaVersion", "reportId", "revision", "status", "renderMode", "update", "meta"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
    "revision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "published", "archived"] },
    "renderMode": { "enum": ["legacy-preserve", "structured"] },
    "templateVersion": { "type": "string", "minLength": 1 },
    "update": {
      "type": "object",
      "required": ["mode", "reason", "changedFields"],
      "properties": {
        "mode": { "enum": ["initial", "full-refresh", "patch", "correction", "corporate-action"] },
        "baseRevision": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 5 },
        "changedFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "legacy": {
      "type": "object",
      "required": ["guidePath", "scenarioPath"],
      "properties": {
        "guidePath": { "type": "string" },
        "scenarioPath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": { "type": "object", "additionalProperties": true },
    "overview": { "type": "object", "additionalProperties": true },
    "guide": { "type": "object", "additionalProperties": true },
    "scenario": { "type": "object", "additionalProperties": true },
    "sources": { "type": "array" },
    "coverageWaivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkId", "waiver_type", "reason", "approvedBy", "approvedAt"],
        "properties": {
          "checkId": { "type": "string" },
          "waiver_type": { "enum": ["acceptable", "blocking"] },
          "reason": { "type": "string", "minLength": 10 },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date" }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": { "enum": ["PASS", "INFO_WARN", "BLOCKING_WARN", "FAIL"] },
        "fail_count": { "type": "integer", "minimum": 0 },
        "blocking_warn_count": { "type": "integer", "minimum": 0 },
        "info_warn_count": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array" },
        "infoWarnMessages": { "type": "array", "items": { "type": "string" } },
        "humanReviewed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "updateHistory": { "type": "array" }
  },
  "additionalProperties": true
}
