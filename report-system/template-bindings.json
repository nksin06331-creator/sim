{
  "$comment": "SiM template-bindings v5 — v6.3対応。3ファイル別個のbindingsから統合HTML(template_report_unified_v5.html)用の1つのbindingsに統合",
  "templateFile": "template_report_unified_v5.html",
  "outputPath": "stocks/{{TICKER}}/index.html",
  "redirectFiles": [
    {
      "outputPath": "stocks/{{TICKER}}/{{TICKER}}.html",
      "comment": "旧URLとの互換性確保。location.replace()でindex.htmlへリダイレクト。サイト内リンクとして使用しない"
    },
    {
      "outputPath": "stocks/{{TICKER}}/catalysts.html",
      "comment": "旧URLとの互換性確保。location.replace()でindex.html?view=catalystへリダイレクト。サイト内リンクとして使用しない"
    }
  ],
  "dataSources": {
    "report": "report-system/reports/{{TICKER}}.report.json",
    "catalyst": "report-system/reports/{{TICKER}}.catalyst.json",
    "catalyst_optional": true,
    "prices": "data/prices.json"
  },
  "catalystHandling": {
    "when_missing": "show_placeholder",
    "when_blocking_warn": "hide_tab",
    "when_info_warn": "show_with_notice",
    "when_no_confirmed_catalyst": "show_with_message",
    "placeholder_text": "カタリストレポートは準備中です"
  },
  "globalBindings": {
    "TICKER": "$.reportId",
    "COMPANY_NAME": "$.meta.companyName",
    "EXCHANGE": "$.meta.exchange",
    "CURRENCY": "$.meta.currency",
    "VALUATION_DATE": "$.meta.valuationDate",
    "LAST_UPDATED": "$.meta.lastUpdated",
    "INDUSTRY": "$.meta.industry",
    "DATE": "$.meta.valuationDate"
  },
  "guideViewBindings": {
    "TAGLINE": "$.overview.tagline",
    "HERO_TAGS": "$.overview.heroTags",
    "HERO_STATS": "$.overview.heroStats",
    "GUIDE_HERO_STATS": "$.overview.heroStats",
    "BUSINESS_SUMMARY": "$.overview.businessSummary",
    "GUIDE_SECTIONS": "$.guide.sections",
    "GUIDE_EXTRA_SECTIONS": "$.guide.extraSections",
    "SEC1_TLDR": "$.guide.sections[?(@.topic=='company')].summaryItems",
    "SEC1_FACTS": "$.guide.sections[?(@.topic=='company')].blocks[?(@.type=='facts')].items",
    "SEC1_CARDS": "$.guide.sections[?(@.topic=='company')].blocks[?(@.type=='cards')].items",
    "SEC1_BIZMODEL": "$.guide.sections[?(@.topic=='company')].blocks[?(@.type=='keypoints')].items",
    "SEC1_HIGHLIGHT": "$.guide.sections[?(@.topic=='company')].blocks[?(@.type=='highlight')]",
    "SEC2_ICON": "$.guide.sections[?(@.topic=='industry')].icon",
    "SEC2_TITLE": "$.guide.sections[?(@.topic=='industry')].title",
    "SEC2_SUB": "$.guide.sections[?(@.topic=='industry')].subtitle",
    "SEC2_LABEL": "$.guide.sections[?(@.topic=='industry')].title",
    "SEC2_TLDR": "$.guide.sections[?(@.topic=='industry')].summaryItems",
    "SEC2_CONTENT": "$.guide.sections[?(@.topic=='industry')].blocks",
    "SEC3_TITLE": "$.guide.sections[?(@.topic=='products')].title",
    "SEC3_SUB": "$.guide.sections[?(@.topic=='products')].subtitle",
    "SEC3_LABEL": "$.guide.sections[?(@.topic=='products')].title",
    "SEC3_TLDR": "$.guide.sections[?(@.topic=='products')].summaryItems",
    "SEC3_CONTENT": "$.guide.sections[?(@.topic=='products')].blocks",
    "SEC4_TITLE": "$.guide.sections[?(@.topic=='operations')].title",
    "SEC4_SUB": "$.guide.sections[?(@.topic=='operations')].subtitle",
    "SEC4_LABEL": "$.guide.sections[?(@.topic=='operations')].title",
    "SEC4_TLDR": "$.guide.sections[?(@.topic=='operations')].summaryItems",
    "SEC4_CONTENT": "$.guide.sections[?(@.topic=='operations')].blocks",
    "SEC5_TITLE": "$.guide.sections[?(@.topic=='competition')].title",
    "SEC5_SUB": "$.guide.sections[?(@.topic=='competition')].subtitle",
    "SEC5_LABEL": "$.guide.sections[?(@.topic=='competition')].title",
    "SEC5_TLDR": "$.guide.sections[?(@.topic=='competition')].summaryItems",
    "SEC5_CONTENT": "$.guide.sections[?(@.topic=='competition')].blocks",
    "SEC6_TLDR": "$.guide.sections[?(@.topic=='glossary')].summaryItems",
    "SEC6_CONTENT": "$.guide.sections[?(@.topic=='glossary')].blocks",
    "SEC7_TLDR": "$.guide.sections[?(@.topic=='catalysts')].summaryItems",
    "SEC7_CONTENT": "$.guide.sections[?(@.topic=='catalysts')].blocks"
  },
  "scenarioViewBindings": {
    "METHOD": "$.scenario.valuation.method",
    "VERDICT_STATUS": "$.scenario.decision.status",
    "VERDICT_LINE_1": "$.scenario.decision.oneLine",
    "VERDICT_LINE_2": "$.scenario.decision.valuationView",
    "SCORE": "$.scenario.decision.score",
    "CURRENT_PRICE": "$.scenario.valuation.currentPrice",
    "CURRENT_PRICE_NOTE": "$.scenario.valuation.currentPriceNote",
    "BASE_PRICE": "$.scenario.scenarios[?(@.name=='Base')].price",
    "BASE_DELTA": "_computed.baseDeltaPct",
    "BASE_PROB": "$.scenario.scenarios[?(@.name=='Base')].probability",
    "EXPECTED_VALUE": "$.scenario.valuation.expectedValue",
    "EXPECTED_DELTA": "_computed.expectedReturnPct",
    "RISK_CLASS": "$.scenario.risk.riskClass",
    "RISK_NOTE": "_computed.riskNote",
    "BEAR_PRICE": "$.scenario.scenarios[?(@.name=='Bear')].price",
    "BEAR_DELTA": "_computed.bearDeltaPct",
    "BEAR_PROB": "$.scenario.scenarios[?(@.name=='Bear')].probability",
    "BEAR_DL_ROWS": "$.scenario.scenarios[?(@.name=='Bear')].details",
    "BASE_DL_ROWS": "$.scenario.scenarios[?(@.name=='Base')].details",
    "BULL_PRICE": "$.scenario.scenarios[?(@.name=='Bull')].price",
    "BULL_DELTA": "_computed.bullDeltaPct",
    "BULL_PROB": "$.scenario.scenarios[?(@.name=='Bull')].probability",
    "BULL_DL_ROWS": "$.scenario.scenarios[?(@.name=='Bull')].details",
    "BAND_POSITION": "_computed.bandPositionPct",
    "ZONE_JUDGE": "_computed.zoneJudge",
    "ZONE_NOTE": "$.scenario.positioning.note",
    "ENDPOINT_RR": "_computed.endpointRR",
    "MARKET_SCORE": "$.scenario.marketReverse.score",
    "OWN_SCORE": "$.scenario.decision.score",
    "MARKET_REVERSE_NOTE": "$.scenario.marketReverse.conclusion",
    "SNAPSHOT_LEAD": "$.scenario.positioning.summary",
    "SCENARIOS_LEAD": "_computed.scenariosLead",
    "PRICE_ZONE_ROWS": "$.scenario.watchItems",
    "SIGNAL_ROWS": "$.scenario.entryContext.catalysts",
    "POSITIVES": "$.scenario.positives",
    "CONCERNS": "$.scenario.concerns",
    "FORMULA": "$.scenario.calculation.formula",
    "CALC_TABLE_HEAD": "$.scenario.calculation.tableHead",
    "CALC_TABLE_ROWS": "$.scenario.calculation.tableRows",
    "CALC_NOTICE": "$.scenario.calculation.notice",
    "CONDITIONS": "$.scenario.scenarios",
    "SENSITIVITY_HEAD": "$.scenario.calculation.sensitivityHead",
    "SENSITIVITY_ROWS": "$.scenario.calculation.sensitivityRows",
    "SENSITIVITY_NOTE": "$.scenario.calculation.sensitivityNote",
    "DIST_LEAD": "$.scenario.calculation.distLead",
    "DIST_ROWS": "$.scenario.calculation.distRows",
    "DIST_SUMMARY": "$.scenario.calculation.distSummary",
    "WATCH_ROWS": "$.scenario.watchItems",
    "ASSUMPTIONS_ROWS": "$.scenario.assumptions",
    "DEEPDIVE_DETAILS": "$.scenario.deepDive",
    "SCENARIO_EXTRA_SECTIONS": "$.scenario.extraSections",
    "DISCLAIMER": "$.scenario.disclaimer",
    "FOOTER_NOTE": "_computed.footerNote",
    "WARN_BAND": "_computed.infoWarnBand"
  },
  "catalystViewBindings": {
    "CATALYST_PLACEHOLDER": "_computed.catalystPlaceholder",
    "REPORT_STATUS": "$.catalyst.summary.status",
    "SUMMARY_LINE_1": "$.catalyst.summary.one_line",
    "SUMMARY_LINE_2": "$.catalyst.summary.primary_risk",
    "OVERALL_PRICED_IN": "$.catalyst.summary.overall_priced_in.percent_range",
    "OVERALL_PRICED_LABEL": "$.catalyst.summary.overall_priced_in.label",
    "PRICED_IN_CONFIDENCE": "$.catalyst.summary.overall_priced_in.confidence",
    "NEXT_CATALYST_TITLE": "_computed.nextCatalystTitle",
    "NEXT_CATALYST_WINDOW": "_computed.nextCatalystWindow",
    "DATE_CONFIDENCE": "_computed.dateConfidenceSummary",
    "CATALYST_COUNT": "_computed.catalystCount",
    "OVERALL_PRICED_BLOCK": "$.catalyst.summary.overall_priced_in",
    "PRICED_IN_METHOD": "$.catalyst.summary.overall_priced_in.model",
    "SURPRISE_UP": "$.catalyst.summary.surprise_up",
    "SURPRISE_DOWN": "$.catalyst.summary.surprise_down",
    "PRIMARY_RISK": "$.catalyst.summary.primary_risk",
    "TIMELINE_ROWS": "$.catalyst.catalysts",
    "CATALYST_CARDS": "$.catalyst.catalysts",
    "DEPENDENCY_ROWS": "$.catalyst.dependency_groups",
    "WATCH_ROWS_CAT": "$.catalyst.watch_items",
    "ASSUMPTIONS_CAT": "$.catalyst.assumptions",
    "SOURCES_CAT": "$.catalyst.sources",
    "WARN_BAND_CAT": "_computed.catalystInfoWarnBand",
    "NO_CATALYST_NOTICE": "_computed.noCatalystNotice"
  },
  "computed": {
    "baseDeltaPct": "((scenario.scenarios[Base].price - scenario.valuation.currentPrice) / scenario.valuation.currentPrice * 100).toFixed(1) + '%'",
    "bearDeltaPct": "((scenario.scenarios[Bear].price - scenario.valuation.currentPrice) / scenario.valuation.currentPrice * 100).toFixed(1) + '%'",
    "bullDeltaPct": "((scenario.scenarios[Bull].price - scenario.valuation.currentPrice) / scenario.valuation.currentPrice * 100).toFixed(1) + '%'",
    "expectedReturnPct": "((scenario.valuation.expectedValue - scenario.valuation.currentPrice) / scenario.valuation.currentPrice * 100).toFixed(1) + '%'",
    "bandPositionPct": "((currentPrice - bearPrice) / (bullPrice - bearPrice) * 100).toFixed(1) + '%'",
    "endpointRR": "(bullDelta / Math.abs(bearDelta)).toFixed(2)",
    "infoWarnBand": "validation.info_warn_count > 0 ? '<div class=\"wrap\"><div class=\"notice\" style=\"margin-top:14px\"><b>注意：</b>' + validation.infoWarnMessages.join(' / ') + '</div></div>' : ''",
    "catalystInfoWarnBand": "catalyst.validation_summary.info_warn_count > 0 ? '<div class=\"wrap\"><div class=\"notice\" style=\"margin-top:14px\"><b>カタリスト注意：</b>' + catalyst.validation_summary.messages.filter(m=>m.level=='INFO_WARN').map(m=>m.message).join(' / ') + '</div></div>' : ''",
    "noCatalystNotice": "catalyst.summary.status == 'NO_CONFIRMED_CATALYST' ? '<div class=\"wrap\"><div class=\"notice\" style=\"margin-top:14px\">現時点で確認できる確定カタリストはありません。詳細は下記の詳細セクションを参照してください。</div></div>' : ''",
    "nextCatalystTitle": "catalyst.catalysts.find(c => c.id == catalyst.summary.next_catalyst_id)?.title ?? '未定'",
    "nextCatalystWindow": "catalyst.catalysts.find(c => c.id == catalyst.summary.next_catalyst_id)?.date.display_text ?? '未定'",
    "catalystCount": "catalyst.catalysts.length",
    "catalystPlaceholder": "catalystAvailable ? '' : '<div class=\"wrap catalyst-placeholder\"><h2>カタリストレポートは準備中です</h2><p>企業ガイドと株価シナリオは公開済みです。</p></div>'",
    "dateConfidenceSummary": "'HIGH: ' + catalyst.catalysts.filter(c=>c.date.confidence=='HIGH').length + ' / MEDIUM: ' + catalyst.catalysts.filter(c=>c.date.confidence=='MEDIUM').length + ' / LOW: ' + catalyst.catalysts.filter(c=>c.date.confidence=='LOW').length",
    "footerNote": "'データ基準日: ' + meta.valuationDate + ' | 現在株価はライブ更新。分析値は評価基準日時点固定'"
  },
  "validationRules": {
    "failOnUnreplacedPlaceholders": true,
    "failOnDangerousHtml": true,
    "failOnMissingRequiredValues": true,
    "failOnBrokenSourceRefs": true,
    "warnOnMissingCatalyst": false,
    "blockOnBearBaseBullMismatch": true,
    "blockOnProbabilityMismatch": true,
    "blockOnCurrencyMismatch": true,
    "requireNoListToIndexLink": true,
    "comment_requireNoListToIndexLink": "v6.3: 銘柄一覧へのリンク（href='../../index.html'）を生成しない。公開スクリプトでの存在チェックも削除"
  }
}
